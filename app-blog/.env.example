# Copiez ce fichier en .env puis adaptez les valeurs
PORT=3001
DATABASE_URL=mongodb://127.0.0.1:27017/grh
# Clé de signature des jetons de connexion : mettez une longue chaîne aléatoire
# (ex. : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=changez_moi
JWT_EXPIRES_IN=8h
# Adresse du front React (autorisée par CORS)
CLIENT_URL=http://localhost:3000
